# ─────────────────────────────────────────────────────────────────────────────
#  Rattebha store — environment configuration
#  Copy to `.env.local` and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the deployed store. Used for canonical URLs, hreflang,
# the sitemap and Open Graph images. REQUIRED BEFORE LAUNCH.
NEXT_PUBLIC_SITE_URL=https://example.com

# Set to "true" to render sample reviews and the yellow "needs data" notes in
# a production build. Leave unset for the live store.
# NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=false


# ── Checkout ────────────────────────────────────────────────────────────────
# none | stripe | shopify | custom   (default: none → checkout answers 501 and
# the cart shows a translated "not connected yet" message)
CHECKOUT_PROVIDER=none

# --- Stripe ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_SINGLE=price_...
# STRIPE_PRICE_BUNDLE=price_...

# --- Shopify Storefront ---
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=...
# SHOPIFY_VARIANT_SINGLE=gid://shopify/ProductVariant/...
# SHOPIFY_VARIANT_BUNDLE=gid://shopify/ProductVariant/...

# --- Custom / local payment provider ---
# CUSTOM_CHECKOUT_ENDPOINT=https://payments.example.com/sessions
# CUSTOM_CHECKOUT_API_KEY=...


# ── Contact form ────────────────────────────────────────────────────────────
# none | webhook | resend   (default: none → the form says the email service
# is not connected instead of faking a successful send)
CONTACT_TRANSPORT=none

# --- webhook ---
# CONTACT_WEBHOOK_URL=https://hooks.example.com/contact

# --- Resend ---
# RESEND_API_KEY=re_...
# CONTACT_TO_EMAIL=support@example.com
# CONTACT_FROM_EMAIL=store@example.com
